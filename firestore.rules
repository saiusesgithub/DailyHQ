rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/linkedin_posts/{postId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/project_ideas/{ideaId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/daily_tasks/{taskId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/recurring_daily_tasks/{recurringTaskId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/todos/{todoId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/daily_journals/{journalId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
